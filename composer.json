{
    "name": "dugger/goshendems",
    "type": "wordpress-theme",
    "description": "Custom WordPress theme for the Goshen City Democratic Party website.",
    "keywords": [
        "WordPress",
        "Themes"
    ],
    "homepage": "https://github.com/dugger/goshendems",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Dugger",
            "homepage": "https://github.com/dugger/goshendems"
        }
    ],
    "require": {
        "php": ">=8.0"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "wptrt/wpthemereview": "^0.2.1",
        "php-parallel-lint/php-parallel-lint": "^1.4",
        "wp-cli/i18n-command": "^2.2.5"
    },
    "scripts": {
        "phpcs": "@php ./vendor/squizlabs/php_codesniffer/bin/phpcs",
        "phpcbf": "@php ./vendor/squizlabs/php_codesniffer/bin/phpcbf",
        "lint:wpcs": "@phpcs",
        "lint:php": "@php ./vendor/bin/parallel-lint --exclude .git --exclude vendor .",
        "make-pot": "wp i18n make-pot . languages/goshendems.pot"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    },
    "support": {
        "issues": "https://github.com/dugger/goshendems/issues",
        "source": "https://github.com/dugger/goshendems"
    }
}
